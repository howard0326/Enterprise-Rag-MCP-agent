# 复制为 .env 后填写真实值：copy .env.example .env
# config/settings.yaml 中的 ${VAR:-default} 占位符会读取这些变量。

APP_ENV=dev

# --- LLM（阶段4 Agent 编排必需）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 2026-10 实测：官方只接受 deepseek-flash 与 deepseek-v4-pro
# （旧名 deepseek-chat 已公告 2026-07-24 停用，仅作兼容别名）
DEEPSEEK_MODEL=deepseek-flash

# --- 嵌入模型 ---
# local = 本地 sentence-transformers 推理（默认，离线可用）
# openai_compatible = 任意 /v1/embeddings 兼容服务
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# --- HuggingFace 下载通道（国内网络必需）---
# huggingface.co 在多数国内网络不可达，改走镜像，否则模型下载会 ConnectTimeout。
HF_ENDPOINT=https://hf-mirror.com
# 受限环境下创建符号链接会失败，置 1 让 huggingface_hub 直接写真实文件副本。
HF_HUB_DISABLE_SYMLINKS=1
HF_HOME=./.cache/huggingface

# --- Qdrant ---
# 用 127.0.0.1 而非 localhost：后者会先尝试 IPv6 ::1，每次请求多等约 2 秒超时
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
